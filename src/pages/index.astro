---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Icon from '../components/Icon.astro';
import InstallCommand from '../components/InstallCommand.astro';
import FileDemo from '../components/FileDemo.astro';
import Features from '../components/Features.astro';
import Waitlist from '../components/Waitlist.astro';

// Measured with the app repo's tests/perf.rs (release build, Apple M4, a generated
// 100,000-transaction vault, 2026-10-18). Re-measure before changing these.
const speed = [
  { n: '85', unit: 'ms', label: 'to open 100,000 transactions' },
  { n: '<13', unit: 'ms', label: 'to switch between views' },
  { n: '6', unit: 'ms', label: 'from an edit to the next frame' },
];

const tree = [
  ['folder', 'My Finances/', 0],
  ['folder', 'Accounts/', 1],
  ['file', 'Chase Checking.md', 2],
  ['file', 'Fidelity Brokerage.md', 2],
  ['folder', 'Ledger/', 1],
  ['folder', 'Chase Checking/', 2],
  ['sheet', '2025.csv', 3],
  ['sheet', '2026.csv', 3],
  ['folder', 'Recurring/', 1],
  ['file', 'Netflix.md', 2],
  ['folder', 'Notes/', 1],
  ['file', '2026 Plan.md', 2],
  ['file', 'Budgets/2026.md', 1],
  ['sheet', 'Rules.csv', 1],
] as const;

const more = [
  ['Command palette & quick switcher', 'Everything is a keystroke away. Date fields accept "9/12", "-3" or "+1w".'],
  ['Net worth, all of it', 'Cash, brokerage, crypto, your home and your loans, tracked by transactions or by balance.'],
  ['Sync without fights', 'Device state lives outside the vault, and conflicting copies are merged row by row.'],
  ['Import your bank', 'CSV import with presets for Chase, Amex, Bank of America, Schwab and Fidelity.'],
  ['Obsidian-shaped', 'Tabs, sidebars, backlinks, an outline and a graph. Open the same folder in Obsidian, too.'],
  ['Exact money', 'Decimal math everywhere. No floating-point pennies, ever.'],
];

const faq = [
  ['Is it free?', 'Yes. The alpha is free.'],
  [
    'Does my data leave my Mac?',
    "No. There's no account and no server. Basalt reads and writes the folder you choose. The one network call fetches stock and crypto quotes, and it sends only ticker symbols to Yahoo Finance. You can turn quotes off.",
  ],
  [
    'What happens if I stop using Basalt?',
    "You keep a folder of CSV and Markdown files that any spreadsheet, text editor or script can read. There's nothing to export.",
  ],
  [
    'Can I use it with Obsidian, git or an LLM?',
    "Yes, that's the point. Open the vault in Obsidian, commit it to git, sync it with iCloud or Syncthing, or point a local model at it. Basalt picks up outside edits live and keeps any columns and keys it doesn't know about.",
  ],
  [
    'Why does macOS block the first launch?',
    'Alpha builds aren\'t signed with an Apple Developer ID yet. Open Basalt once, then go to System Settings → Privacy & Security and choose "Open Anyway". You only need to do this once per version.',
  ],
  ['Which Macs does it run on?', 'Apple silicon Macs (M1 and later) for now.'],
  [
    'Is Basalt open source?',
    'No, the app is closed source. Your data is in open formats, so you never depend on the app to read it.',
  ],
  [
    'Is it safe to use with my real finances?',
    "Basalt is alpha software, and it writes to your files. Every write is atomic, but keep a backup of your vault anyway. Git and Time Machine both work well.",
  ],
];
---

<Base>
  <Nav />
  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">Free alpha · macOS · Apple silicon</p>
        <h1>Your money<br />is a folder.</h1>
        <p class="lede">
          Basalt is a fast, local-first finance app. Every account, transaction and budget is a plain CSV or Markdown file
          that you own. Back it up with anything, diff it in git, open it in Excel, or hand it to a local LLM.
        </p>
        <div class="cta">
          <InstallCommand />
          <a class="text-link" href="#waitlist">Waiting for 1.0? Get notified <Icon name="arrow" /></a>
        </div>
        <div class="demo-wrap">
          <FileDemo />
        </div>
      </div>
    </section>

    <!-- Files over app -->
    <section id="files" class="files">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow">Files over app</p>
          <h2>The app is a lens.<br />The files are the product.</h2>
          <p class="lede">
            Most finance apps keep your history in a database only they can read. Basalt keeps it in the most durable
            formats there are, in a folder you choose. If the app vanished tomorrow, you'd lose nothing.
          </p>
        </div>

        <div class="pillars">
          <article class="pillar reveal">
            <div class="file">
              <div class="file-tab"><Icon name="folder" /> ~/Documents/My Finances</div>
              <ul class="tree" aria-label="A Basalt vault">
                {
                  tree.map(([icon, name, depth], i) => (
                    <li style={`--d:${depth};--i:${i}`}>
                      <Icon name={icon} />
                      {name}
                    </li>
                  ))
                }
              </ul>
            </div>
            <h3>You own it</h3>
            <p>
              No account and no server. One note per account, one CSV per year of transactions. Delete the app and your
              money is still a folder you can read.
            </p>
          </article>

          <article class="pillar reveal">
            <div class="file">
              <div class="file-tab"><Icon name="terminal" /> git diff</div>
              <pre><span class="k">@@ Ledger/Amex Gold/2026.csv @@</span>
<span class="del">-…,2026-09-30,…,Blue Bottle,Food/Dining,,,</span>
<span class="add">+…,2026-09-30,…,Blue Bottle,Food/Coffee,,,</span>
<span class="k">@@ Budgets/2026.md @@</span>
<span class="del">-  Food/Dining: 950</span>
<span class="add">+  Food/Dining: 900</span></pre>
            </div>
            <h3>Back up and sync with anything</h3>
            <p>
              iCloud, Dropbox, Syncthing, git or Time Machine. Edits rewrite only the rows they touch, so every diff is
              readable. Layout and price caches live outside the vault, so two Macs never fight over them.
            </p>
          </article>

          <article class="pillar reveal">
            <div class="file">
              <div class="file-tab"><Icon name="spark" /> local model</div>
              <pre class="chat"><span class="k">you ›</span> <span class="v">How much have I spent on dining since June?</span>
<span class="k">llm ›</span> From Ledger/*/2026.csv: 129 Food/Dining rows since June 1, totaling <span class="v">$3,243.68</span>.</pre>
            </div>
            <h3>Ready for local LLMs</h3>
            <p>
              Language models read CSV and Markdown well. Point Ollama, LM Studio or any agent at the folder and ask about
              your money without uploading it anywhere.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Speed -->
    <section class="speed">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow">Fast</p>
          <h2>Fast enough to stop noticing.</h2>
          <p class="lede">
            Native Rust with a GPU-rendered interface. The whole vault is indexed in memory, edits land on the next frame,
            and CSV writes happen off the main thread. Editing a ledger feels like editing a spreadsheet, not like waiting
            for a database.
          </p>
        </div>
        <dl class="stats reveal">
          {
            speed.map((s) => (
              <div>
                <dt>
                  {s.n}
                  <span>{s.unit}</span>
                </dt>
                <dd>{s.label}</dd>
              </div>
            ))
          }
        </dl>
        <p class="footnote reveal">Measured on an Apple M4 with a generated 100,000-transaction vault (8 MB of CSV).</p>
        <picture class="window big reveal">
          <source srcset="/shots/ledger-light.webp" media="(prefers-color-scheme: light)" />
          <img
            src="/shots/ledger-dark.webp"
            width="1320"
            height="860"
            loading="lazy"
            decoding="async"
            alt="A year of Chase Checking transactions in Basalt's ledger table."
          />
        </picture>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="features-section">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow">For power users</p>
          <h2>Everything you'd build yourself, if you had the weekends.</h2>
        </div>
        <Features />

        <div class="more">
          {
            more.map(([t, d]) => (
              <div class="reveal">
                <h3>{t}</h3>
                <p>{d}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Coming later -->
    <section class="next">
      <div class="wrap next-grid">
        <div class="reveal">
          <p class="eyebrow">Coming later</p>
          <h2>A <code>basalt</code> CLI.</h2>
          <p class="lede">
            The same engine and query language as the app, in your terminal. It's built for scripts, cron jobs, and agents
            that want JSON instead of screenshots.
          </p>
        </div>
        <div class="file reveal">
          <div class="file-tab"><Icon name="terminal" /> zsh <span class="soon">preview</span></div>
          <pre><span class="k">$</span> <span class="v">basalt spending category:"Food/Dining" months:3</span>
  Jul     $375.85
  Aug   $1,193.86
  Sep     $820.91   <span class="k">on pace for $925</span>
<span class="k">$</span> <span class="v">basalt add expense "Whole Foods" 54.20 --account "Amex Gold"</span>
  <span class="add">✓</span> Ledger/Amex Gold/2026.csv  +1 row</pre>
        </div>
      </div>
    </section>

    <!-- Install + waitlist -->
    <section id="install" class="install-section">
      <div class="wrap install-grid">
        <div class="reveal">
          <p class="eyebrow">Install the alpha</p>
          <h2>Try it on your Mac today.</h2>
          <ol class="steps">
            <li>
              <span>Install with Homebrew.</span>
              <InstallCommand />
            </li>
            <li>
              <span>
                Open Basalt. Alpha builds aren't signed yet, so macOS blocks the first launch. In <b
                  >System Settings → Privacy & Security</b
                >, choose <b>Open Anyway</b>.
              </span>
            </li>
            <li><span>Pick a folder for your vault, or explore the built-in demo first.</span></li>
          </ol>
          <p class="fine">Free · Apple silicon · Alpha software that writes to your files, so keep a backup of your vault.</p>
        </div>
        <div id="waitlist" class="card reveal">
          <h3>Rather wait for 1.0?</h3>
          <p>
            Get one email when the signed public release ships. No newsletter, and we won't share your address.
          </p>
          <Waitlist />
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="faq">
      <div class="narrow">
        <h2 class="reveal">Questions</h2>
        {
          faq.map(([q, a]) => (
            <details class="reveal">
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap foot">
      <span class="brand"><img src="/favicon.svg" width="18" height="18" alt="" /> Basalt</span>
      <span class="muted">© {new Date().getFullYear()} Naval Monga · No cookies, no tracking.</span>
      <a href="#install">Install</a>
    </div>
  </footer>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-top: clamp(56px, 9vw, 112px);
    overflow: clip;
    text-align: center;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -20% 10% auto;
    height: 640px;
    background: radial-gradient(closest-side, var(--accent-wash), transparent);
    pointer-events: none;
  }
  .hero .wrap {
    position: relative;
  }
  .hero .lede {
    margin-inline: auto;
  }
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-top: 36px;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-2);
    font-size: 14px;
    text-decoration: none;
  }
  .text-link:hover {
    color: var(--ink);
  }
  .text-link :global(svg) {
    width: 15px;
    height: 15px;
    transition: transform 0.15s;
  }
  .text-link:hover :global(svg) {
    transform: translateX(3px);
  }
  .demo-wrap {
    margin-top: clamp(48px, 7vw, 80px);
  }

  /* Files */
  .files {
    border-top: 1px solid var(--hairline);
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .pillar h3 {
    margin-top: 24px;
  }
  .pillar p {
    margin: 8px 0 0;
    color: var(--ink-2);
    font-size: 15px;
    text-wrap: pretty;
  }
  .pillar .file {
    height: 268px;
  }
  .pillar pre {
    white-space: pre;
  }
  .pillar pre.chat {
    white-space: pre-wrap;
  }
  .tree {
    margin: 0;
    padding: 10px 14px;
    list-style: none;
    font: 12.5px/1.75 var(--mono);
    color: var(--ink-2);
  }
  .tree li {
    display: flex;
    align-items: center;
    gap: 7px;
    padding-left: calc(var(--d) * 16px);
  }
  .tree :global(svg) {
    width: 14px;
    height: 14px;
    color: var(--muted);
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tree li {
        animation: tree-in linear both;
        animation-timeline: view();
        animation-range: entry calc(10% + var(--i) * 2%) cover calc(22% + var(--i) * 2%);
      }
    }
  }
  @keyframes tree-in {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
  }

  /* Speed */
  .speed {
    background: var(--sidebar);
    border-block: 1px solid var(--hairline);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 0;
  }
  .stats div {
    padding: 24px 0 0;
    border-top: 1px solid var(--border);
  }
  .stats dt {
    font-size: clamp(48px, 7vw, 84px);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .stats dt span {
    margin-left: 4px;
    color: var(--muted);
    font-size: 0.4em;
    letter-spacing: 0;
  }
  .stats dd {
    margin: 10px 0 0;
    color: var(--ink-2);
  }
  .footnote {
    margin: 20px 0 56px;
    color: var(--muted);
    font-size: 13px;
  }
  .big img {
    width: 100%;
  }

  /* More features */
  .more {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 32px;
    margin-top: clamp(80px, 11vw, 136px);
    padding-top: 56px;
    border-top: 1px solid var(--hairline);
  }
  .more h3 {
    font-size: 16px;
  }
  .more p {
    margin: 6px 0 0;
    color: var(--ink-2);
    font-size: 15px;
  }

  /* CLI */
  .next {
    border-top: 1px solid var(--hairline);
  }
  .next-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(32px, 6vw, 72px);
  }
  .next h2 code {
    font-size: 0.9em;
    color: var(--accent);
  }
  .soon {
    margin-left: auto;
    padding: 1px 8px;
    border: 1px solid var(--border);
    border-radius: 99px;
    color: var(--muted);
    font-size: 11px;
  }

  /* Install */
  .install-section {
    background: var(--sidebar);
    border-block: 1px solid var(--hairline);
  }
  .install-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(32px, 6vw, 80px);
  }
  .steps {
    display: grid;
    gap: 22px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 10px 14px;
    align-items: start;
    counter-increment: step;
    color: var(--ink-2);
  }
  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--ink);
    font: 600 13px var(--sans);
  }
  .steps li > span {
    padding-top: 2px;
  }
  .steps li > :global(.install) {
    grid-column: 2;
    justify-self: start;
  }
  .steps b {
    color: var(--ink);
    font-weight: 600;
  }
  .fine {
    margin: 28px 0 0;
    color: var(--muted);
    font-size: 13px;
  }
  .card {
    padding: 32px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--content);
  }
  .card h3 {
    font-size: 22px;
  }
  .card p {
    margin: 10px 0 22px;
    color: var(--ink-2);
    font-size: 15px;
  }

  /* FAQ */
  .faq h2 {
    margin-bottom: 32px;
  }
  details {
    border-bottom: 1px solid var(--hairline);
  }
  summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    font-weight: 550;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    color: var(--muted);
    font-weight: 400;
    transition: transform 0.2s;
  }
  details[open] summary::after {
    transform: rotate(45deg);
  }
  details p {
    margin: -6px 0 22px;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  footer {
    padding: 36px 0 48px;
    border-top: 1px solid var(--hairline);
    font-size: 14px;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .foot .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 650;
  }
  .foot a {
    color: var(--ink-2);
  }

  @media (max-width: 960px) {
    .pillars,
    .more {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .next-grid,
    .install-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .pillars,
    .more,
    .stats {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
