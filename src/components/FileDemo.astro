---
// The hero demo, in two beats:
//   1. You work in the app: a transaction is recategorized inline, and exactly one line of the
//      ledger CSV changes (Basalt re-emits untouched rows verbatim).
//   2. Something else edits the file (an editor, a script, an agent): a row is appended with a
//      blank id; Basalt picks it up live, assigns a ULID and writes it back.
// Everything shown is real behavior. Rows and totals are the demo vault's as of 2026-09-28, the
// same data as the screenshots.
import Icon from './Icon.astro';

const header = 'id,date,type,amount,currency,symbol,quantity,price,fee,payee,category,transfer,tags,memo';
const rows = [
  ['01M34H', '2026-09-22,expense,-20.89,USD,,,,,Sweetgreen,Food/Dining,,,'],
  ['01M34H', '2026-09-22,expense,-62.55,USD,,,,,Home Depot,Housing/Maintenance,,,'],
  ['01M374', '2026-09-23,expense,-17.47,USD,,,,,Chipotle,Food/Dining,,,'],
  ['01M374', '2026-09-23,expense,-40.70,USD,,,,,Safeway,Food/Groceries,,,'],
  ['01M3EV', '2026-09-26,expense,-26.82,USD,,,,,AMC Theatres,Entertainment,,,'],
  ['01M3HC', "2026-09-27,expense,-26.58,USD,,,,,Trader Joe's,Food/Groceries,,,"],
  ['01M3KY', '2026-09-28,expense,-33.38,USD,,,,,Uber,Transport/Rideshare,,,'],
  ['01M3KY', "2026-09-28,expense,-70.19,USD,,,,,Trader Joe's,Food/Groceries,,,"],
];
// The row recategorized in beat 1.
const target = { id: '01M3KZ', pre: '2026-09-28,expense,-14.56,USD,,,,,Tartine,', from: 'Food/Dining', to: 'Food/Coffee' };
// The row appended in beat 2 (blank id).
const typed = ',2026-09-28,expense,-54.20,USD,,,,,Whole Foods,Food/Groceries,,,';

// Spending, September: top five categories plus "Other" (color follows the category).
const cats = [
  { name: 'Housing', amount: 2490, color: 'var(--s1)' },
  { name: 'Food', amount: 1560, after: 1614, color: 'var(--s2)' },
  { name: 'Shopping', amount: 828, color: 'var(--s3)' },
  { name: 'Loans', amount: 612, color: 'var(--s4)' },
  { name: 'Transport', amount: 321, color: 'var(--s5)' },
  { name: 'Other', amount: 627, color: 'var(--other)' },
];
const max = 2490;
const txns = [
  ["Trader Joe's", 'Food/Groceries', '−$70.19'],
  ['Uber', 'Transport/Rideshare', '−$33.38'],
  ["Trader Joe's", 'Food/Groceries', '−$26.58'],
];
const usd = (n: number) => '$' + n.toLocaleString('en-US');

const notes = {
  start: 'Your ledger, exactly as Basalt stores it.',
  recat: 'Basalt rewrote one line. Every other line is untouched.',
  outside: 'Or edit the file from anywhere: vim, Excel, a script, an LLM agent.',
  synced: 'Basalt picked up the new row, gave it an id and wrote it back.',
  final: 'Basalt rewrote one line, another app added one, and both sides agree.',
};
---

<figure class="demo" data-demo data-typed={typed} data-to={target.to} data-notes={JSON.stringify(notes)}>
  <div class="panes window">
    <!-- App -->
    <div class="pane app" aria-hidden="true">
      <div class="app-head">
        <span class="muted">Spending · September</span>
        <span class="live"><i></i> Watching vault</span>
      </div>
      <div class="total">
        <span class="b">{usd(6438)}</span><span class="a">{usd(6492)}</span>
        <small>of $8,305 budget</small>
      </div>
      <ul class="cats">
        {
          cats.map((c) => (
            <li
              class:list={[{ grows: c.after }]}
              style={`--c:${c.color};--w:${(c.amount / max) * 100}%;--w2:${((c.after ?? c.amount) / max) * 100}%`}
            >
              <span class="name">{c.name}</span>
              <span class="bar">
                <i />
              </span>
              <span class="amt">
                {c.after ? (
                  <>
                    <span class="b">{usd(c.amount)}</span>
                    <span class="a">{usd(c.after)}</span>
                  </>
                ) : (
                  usd(c.amount)
                )}
              </span>
            </li>
          ))
        }
      </ul>
      <div class="txns">
        <div class="rh"><span>Transactions</span><span class="muted">Amex Gold</span></div>
        <ul>
          <li class="added"><span>Whole Foods</span><span class="chip">Food/Groceries</span><span>−$54.20</span></li>
          <li class="target">
            <span>Tartine</span>
            <span class="chip cat-edit">
              <span class="v-from">{target.from}</span>
              <span class="v-edit"><span class="etext"></span><span class="caret"></span></span>
              <span class="v-to">{target.to}</span>
            </span>
            <span>−$14.56</span>
          </li>
          {
            txns.map(([p, c, a]) => (
              <li>
                <span>{p}</span>
                <span class="chip">{c}</span>
                <span>{a}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <svg class="pointer" viewBox="0 0 16 22" aria-hidden="true">
        <path d="M1 1v17l4.5-4.2 3 6.7 2.8-1.3-3-6.6H14z"></path>
      </svg>
    </div>

    <!-- File -->
    <div class="pane src">
      <div class="file-tab">
        <Icon name="sheet" />
        <span>Ledger/Amex Gold/2026.csv</span>
        <span class="saved s-basalt">Saved by Basalt</span>
        <span class="saved s-outside">Saved in another app</span>
      </div>
      <pre aria-hidden="true"><span class="k">{header}</span>
{rows.map(([id, rest]) => <><span class="id">{id}…</span>,{rest}{'\n'}</>)}<span class="line recat"><span class="id">{target.id}…</span>,{target.pre}<span class="cat"><span class="v-from">{target.from}</span><span class="v-to">{target.to}</span></span>,,,</span>
<span class="line new"><span class="id assigned">01M3T2…</span><span class="typed"></span><span class="caret"></span></span></pre>
      <p class="note"><span class="ok"><Icon name="check" /></span><span class="text">{notes.start}</span></p>
    </div>
  </div>
  <figcaption>
    <ol class="beats">
      <li class="beat-1"><span>1</span>Work in the app. One line of the file changes.</li>
      <li class="beat-2"><span>2</span>Or change the file anywhere. The app follows.</li>
    </ol>
    <p class="sr-only">
      Animation: a transaction is recategorized in Basalt and exactly one line of the ledger CSV changes; then a new
      row is added to the CSV from another app, and Basalt shows it and writes its id back.
    </p>
  </figcaption>
</figure>

<style>
  .demo {
    margin: 0;
  }
  .panes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    text-align: left;
  }
  .pane {
    min-width: 0;
  }

  /* ── App side ──────────────────────────────── */
  .app {
    position: relative;
    padding: 18px 22px 16px;
    border-right: 1px solid var(--hairline);
    background: var(--content);
    font-size: 13px;
  }
  .app-head {
    display: flex;
    justify-content: space-between;
    font-size: 12.5px;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
  }
  .live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--up);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--up) 60%, transparent);
  }
  .total {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 6px 0 12px;
  }
  .total .b,
  .total .a {
    font-size: 32px;
    font-weight: 650;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .total small {
    color: var(--muted);
  }
  .a {
    display: none;
  }
  .cats {
    display: grid;
    gap: 6px;
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }
  .cats li {
    display: grid;
    grid-template-columns: 74px 1fr 52px;
    align-items: center;
    gap: 10px;
    margin: 0 -8px;
    padding: 1px 8px;
    border-radius: 6px;
    transition: background 0.5s;
  }
  .name {
    color: var(--ink-2);
  }
  .bar {
    height: 7px;
    overflow: hidden;
    border-radius: 4px;
    background: var(--hairline);
  }
  .bar i {
    display: block;
    width: var(--w);
    height: 100%;
    border-radius: 4px;
    background: var(--c);
    transition: width 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .amt {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .txns {
    padding-top: 12px;
    border-top: 1px solid var(--hairline);
  }
  .rh {
    display: flex;
    justify-content: space-between;
    margin-bottom: 2px;
    font-weight: 600;
  }
  .rh .muted {
    font-weight: 400;
    font-size: 12px;
  }
  /* Fixed height (four rows): a new row pushes the oldest out of view instead of growing the
     demo, so nothing below it shifts on each loop. */
  .txns ul {
    --row: 34px;
    height: calc(4 * var(--row));
    margin: 0;
    padding: 0;
    overflow: hidden;
    list-style: none;
  }
  .txns li {
    display: grid;
    grid-template-columns: 1fr auto 64px;
    align-items: center;
    gap: 12px;
    box-sizing: border-box;
    height: var(--row);
    padding: 0;
    border-bottom: 1px solid var(--hairline);
    font-variant-numeric: tabular-nums;
  }
  .txns li:last-child {
    border-bottom: 0;
  }
  .txns li > span:last-child {
    text-align: right;
  }
  .chip {
    padding: 1px 7px;
    border: 1px solid transparent;
    border-radius: 5px;
    background: var(--raised);
    color: var(--ink-2);
    font-size: 12px;
    transition:
      background 0.3s,
      border-color 0.2s;
  }
  .cat-edit .v-edit,
  .cat-edit .v-to {
    display: none;
  }
  .txns li.added {
    height: 0;
    overflow: hidden;
    border-bottom-width: 0;
    opacity: 0;
    transition:
      height 0.45s ease,
      opacity 0.45s ease 0.1s;
  }
  .pointer {
    position: absolute;
    top: 0;
    left: 0;
    width: 16px;
    height: 22px;
    fill: var(--ink);
    stroke: var(--app);
    stroke-width: 1.2;
    opacity: 0;
    transform: translate(var(--px, 300px), var(--py, 420px));
    transition:
      transform 0.9s cubic-bezier(0.3, 0.7, 0.2, 1),
      opacity 0.3s;
    pointer-events: none;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.4));
  }

  /* ── File side ─────────────────────────────── */
  .src {
    display: flex;
    flex-direction: column;
    background: var(--content);
  }
  .saved {
    display: none;
    margin-left: auto;
    padding: 2px 8px;
    border-radius: 99px;
    background: var(--accent-wash);
    color: var(--accent);
    font-size: 11px;
  }
  pre {
    flex: 1;
    margin: 0;
    padding: 16px 18px;
    overflow: hidden;
    color: var(--ink-2);
    font: 12.5px/1.85 var(--mono);
    white-space: pre;
    mask-image: linear-gradient(to right, #000 88%, transparent);
  }
  .k,
  .id {
    color: var(--muted);
  }
  .line {
    display: inline-block;
    margin: 0 -18px;
    padding: 0 18px;
    transition: background 0.4s;
  }
  .cat .v-to {
    display: none;
  }
  .new {
    min-height: 1.85em;
  }
  .assigned {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    vertical-align: bottom;
    color: var(--accent);
    transition: max-width 0.5s ease;
  }
  .typed {
    color: var(--ink);
  }
  .caret {
    display: none;
    width: 7px;
    height: 1.2em;
    margin-left: 1px;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  .cat-edit .caret {
    width: 1.5px;
    height: 1.1em;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .note {
    display: flex;
    gap: 6px;
    align-items: center;
    margin: 0;
    padding: 12px 18px;
    border-top: 1px solid var(--hairline);
    color: var(--muted);
    font-size: 13px;
    min-height: 46px;
  }
  .note .text {
    transition: opacity 0.25s;
  }
  .note.swap .text {
    opacity: 0;
  }
  .ok {
    display: none;
    color: var(--up);
  }
  .ok :global(svg) {
    display: block;
    width: 15px;
    height: 15px;
  }
  .note.done {
    color: var(--ink-2);
  }
  .note.done .ok {
    display: block;
  }

  /* ── Caption: the two beats ────────────────── */
  figcaption {
    margin-top: 20px;
  }
  .beats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 14px;
  }
  .beats li {
    display: flex;
    align-items: center;
    gap: 8px;
    transition: color 0.3s;
  }
  .beats li span {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 1px solid var(--border);
    border-radius: 50%;
    font-size: 11px;
    transition:
      background 0.3s,
      border-color 0.3s,
      color 0.3s;
  }

  /* ── States (set by the script) ────────────── */
  /* beat 1 */
  [data-state~='b1'] .beat-1,
  [data-state~='b2'] .beat-2 {
    color: var(--ink);
  }
  [data-state~='b1'] .beat-1 span,
  [data-state~='b2'] .beat-2 span {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }
  [data-state~='point'] .pointer {
    opacity: 1;
  }
  [data-state~='editing'] .cat-edit {
    border-color: var(--accent);
    background: var(--content);
    outline: 3px solid var(--accent-wash);
  }
  [data-state~='editing'] .cat-edit .v-from,
  [data-state~='recat'] .cat-edit .v-from {
    display: none;
  }
  [data-state~='editing'] .cat-edit .v-edit {
    display: inline;
  }
  [data-state~='editing'] .cat-edit .caret {
    display: inline-block;
  }
  [data-state~='recat'] .cat-edit .v-edit {
    display: none;
  }
  [data-state~='recat'] .cat-edit .v-to {
    display: inline;
  }
  [data-state~='recat'] .s-basalt {
    display: inline;
  }
  [data-state~='recat'] .cat .v-from {
    display: none;
  }
  [data-state~='recat'] .cat .v-to {
    display: inline;
    color: var(--accent);
  }
  [data-state~='recat'] .recat {
    background: var(--accent-wash);
  }
  [data-state~='recat'] .target .chip {
    background: var(--accent-wash);
    color: var(--ink);
  }
  /* beat 2: the recategorized row settles */
  [data-state~='b2'] .recat,
  [data-state~='b2'] .target .chip {
    background: transparent;
  }
  [data-state~='b2'] .target .chip {
    background: var(--raised);
  }
  [data-state~='b2'] .cat .v-to {
    color: inherit;
  }
  [data-state~='b2'] .s-basalt {
    display: none;
  }
  [data-state~='typing'] .new .caret {
    display: inline-block;
  }
  [data-state~='saved'] .s-outside {
    display: inline;
  }
  [data-state~='synced'] .total .b,
  [data-state~='synced'] .amt .b {
    display: none;
  }
  [data-state~='synced'] .total .a,
  [data-state~='synced'] .amt .a {
    display: inline;
  }
  [data-state~='synced'] .grows {
    background: var(--accent-wash);
  }
  [data-state~='synced'] .grows .bar i {
    width: var(--w2);
  }
  [data-state~='synced'] .txns li.added {
    height: var(--row);
    border-bottom-width: 1px;
    opacity: 1;
  }
  [data-state~='synced'] .live i {
    animation: ping 1s ease-out;
  }
  @keyframes ping {
    to {
      box-shadow: 0 0 0 8px transparent;
    }
  }
  [data-state~='id'] .assigned {
    max-width: 8ch;
  }
  [data-state~='id'] .new {
    background: var(--accent-wash);
  }
  [data-state~='id'] .grows {
    background: transparent;
  }
  [data-state~='fade'] .panes {
    opacity: 0.35;
    transition: opacity 0.4s;
  }
  /* Reduced motion / no JS-driven loop: the end state, both beats shown. */
  [data-state~='final'] .beats li {
    color: var(--ink-2);
  }

  @media (max-width: 860px) {
    .panes {
      grid-template-columns: minmax(0, 1fr);
    }
    .app {
      border-right: 0;
      border-bottom: 1px solid var(--hairline);
    }
    pre {
      font-size: 11px;
    }
  }
</style>

<script>
  const demo = document.querySelector<HTMLElement>('[data-demo]');
  if (demo) {
    const typedEl = demo.querySelector<HTMLElement>('.typed')!;
    const editEl = demo.querySelector<HTMLElement>('.etext')!;
    const chip = demo.querySelector<HTMLElement>('.cat-edit')!;
    const app = demo.querySelector<HTMLElement>('.app')!;
    const pointer = demo.querySelector<SVGElement>('.pointer')!;
    const note = demo.querySelector<HTMLElement>('.note')!;
    const noteText = note.querySelector<HTMLElement>('.text')!;
    const typed = demo.dataset.typed ?? '';
    const to = demo.dataset.to ?? '';
    const notes = JSON.parse(demo.dataset.notes ?? '{}') as Record<string, string>;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const set = (s: string) => (demo.dataset.state = s);
    let visible = false;
    let running = false;

    const say = async (key: string, done = false) => {
      note.classList.add('swap');
      await sleep(200);
      noteText.textContent = notes[key] ?? '';
      note.classList.toggle('done', done);
      note.classList.remove('swap');
    };
    const type = async (el: HTMLElement, text: string, fast = 32, comma = 70) => {
      for (let i = 1; i <= text.length; i++) {
        if (!visible) return false;
        el.textContent = text.slice(0, i);
        await sleep(text[i - 1] === ',' ? comma : fast);
      }
      return true;
    };
    // Park the pointer below the table, then glide it onto the category chip.
    const aim = (onChip: boolean) => {
      const a = app.getBoundingClientRect();
      const c = chip.getBoundingClientRect();
      const x = onChip ? c.left - a.left + c.width * 0.55 : a.width * 0.7;
      const y = onChip ? c.top - a.top + c.height * 0.45 : a.height - 10;
      pointer.style.setProperty('--px', `${x}px`);
      pointer.style.setProperty('--py', `${y}px`);
    };

    const finalState = () => {
      typedEl.textContent = typed;
      editEl.textContent = '';
      noteText.textContent = notes.final;
      note.classList.add('done');
      set('final recat saved synced id');
    };

    async function loop() {
      if (running) return;
      running = true;
      while (visible) {
        // reset
        typedEl.textContent = '';
        editEl.textContent = '';
        aim(false);
        set('b1');
        await say('start');
        await sleep(700);

        // beat 1: recategorize in the app
        set('b1 point');
        await sleep(80);
        aim(true);
        await sleep(1000);
        set('b1 point editing');
        await sleep(350);
        if (!(await type(editEl, to, 55, 55))) break;
        await sleep(350);
        set('b1 recat');
        await say('recat', true);
        await sleep(2600);

        // beat 2: the file changes elsewhere
        set('b2 recat typing');
        await say('outside');
        await sleep(500);
        if (!(await type(typedEl, typed))) break;
        await sleep(400);
        set('b2 recat saved');
        await sleep(600);
        set('b2 recat saved synced');
        await sleep(1300);
        set('b2 recat saved synced id');
        await say('synced', true);
        await sleep(3800);
        set('b2 recat saved synced id fade');
        await sleep(450);
      }
      running = false;
      if (!visible) finalState();
    }

    if (reduce || !('IntersectionObserver' in window)) {
      finalState();
    } else {
      new IntersectionObserver(
        ([e]) => {
          visible = e.isIntersecting;
          if (visible) loop();
        },
        { threshold: 0.35 },
      ).observe(demo);
    }
  }
</script>
