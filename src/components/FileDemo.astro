---
// The hero demo: a row typed into a ledger CSV shows up in the app, and Basalt writes the
// new row's id back into the file. Everything here is real behavior (blank ids get a fresh
// ULID, written back; the folder watcher reloads changed files). The rows and totals are the
// demo vault's as of 2026-09-28, the same data as the screenshots.
import Icon from './Icon.astro';

const header = 'id,date,type,amount,currency,symbol,quantity,price,fee,payee,category,transfer,tags,memo';
const rows = [
  ['01M34H', '2026-09-22,expense,-20.89,USD,,,,,Sweetgreen,Food/Dining,,,'],
  ['01M34H', '2026-09-22,expense,-62.55,USD,,,,,Home Depot,Housing/Maintenance,,,'],
  ['01M34J', "2026-09-22,expense,-27.68,USD,,,,,Trader Joe's,Food/Groceries,,,"],
  ['01M374', '2026-09-23,expense,-17.47,USD,,,,,Chipotle,Food/Dining,,,'],
  ['01M374', '2026-09-23,expense,-40.70,USD,,,,,Safeway,Food/Groceries,,,'],
  ['01M3EV', '2026-09-26,expense,-26.82,USD,,,,,AMC Theatres,Entertainment,,,'],
  ['01M3HC', "2026-09-27,expense,-26.58,USD,,,,,Trader Joe's,Food/Groceries,,,"],
  ['01M3KY', '2026-09-28,expense,-33.38,USD,,,,,Uber,Transport/Rideshare,,,'],
  ['01M3KY', "2026-09-28,expense,-70.19,USD,,,,,Trader Joe's,Food/Groceries,,,"],
  ['01M3KZ', '2026-09-28,expense,-14.56,USD,,,,,Tartine,Food/Dining,,,'],
];
const typed = ',2026-09-28,expense,-54.20,USD,,,,,Whole Foods,Food/Groceries,,,';

// Spending, September: top five categories plus "Other" (color follows the category).
const cats = [
  { name: 'Housing', amount: 2490, color: 'var(--s1)' },
  { name: 'Food', amount: 1560, after: 1614, color: 'var(--s2)' },
  { name: 'Shopping', amount: 828, color: 'var(--s3)' },
  { name: 'Loans', amount: 612, color: 'var(--s4)' },
  { name: 'Transport', amount: 321, color: 'var(--s5)' },
  { name: 'Other', amount: 627, color: 'var(--other)' },
];
const max = 2490;
const recent = [
  ['Tartine', 'Food/Dining', '−$14.56'],
  ["Trader Joe's", 'Food/Groceries', '−$70.19'],
  ['Uber', 'Transport/Rideshare', '−$33.38'],
  ["Trader Joe's", 'Food/Groceries', '−$26.58'],
];
const usd = (n: number) => '$' + n.toLocaleString('en-US');
---

<figure class="demo" data-demo data-typed={typed} aria-label="Typing a row into a CSV file updates Basalt">
  <div class="panes window">
    <div class="pane src">
      <div class="file-tab">
        <Icon name="sheet" />
        <span>Ledger/Amex Gold/2026.csv</span>
        <span class="saved">Saved</span>
      </div>
      <pre aria-hidden="true"><span class="k">{header}</span>
{rows.map(([id, rest]) => <><span class="id">{id}…</span>,{rest}{'\n'}</>)}<span class="new"><span class="id assigned">01M3T2…</span><span class="typed"></span><span class="caret"></span></span></pre>
      <p class="note"><span class="n1">Any editor: vim, Numbers, Excel, a script, an LLM agent.</span><span class="n2"><Icon name="check" /> Basalt gave the new row an id and wrote it back. Nothing else in the file changed.</span></p>
    </div>

    <div class="pane app" aria-hidden="true">
      <div class="app-head">
        <span class="muted">Spending · September</span>
        <span class="live"><i></i> Watching vault</span>
      </div>
      <div class="total">
        <span class="b">{usd(6438)}</span><span class="a">{usd(6492)}</span>
        <small>of $8,305 budget</small>
      </div>
      <ul class="cats">
        {
          cats.map((c) => (
            <li class:list={[{ grows: c.after }]} style={`--c:${c.color};--w:${(c.amount / max) * 100}%;--w2:${((c.after ?? c.amount) / max) * 100}%`}>
              <span class="name">{c.name}</span>
              <span class="bar"><i /></span>
              <span class="amt">
                {c.after ? (<><span class="b">{usd(c.amount)}</span><span class="a">{usd(c.after)}</span></>) : usd(c.amount)}
              </span>
            </li>
          ))
        }
      </ul>
      <div class="recent">
        <div class="rh"><span>Recent</span><span class="muted">all accounts</span></div>
        <ul>
          <li class="added"><span>Whole Foods</span><span class="muted">Food/Groceries</span><span>−$54.20</span></li>
          {recent.map(([p, c, a]) => <li><span>{p}</span><span class="muted">{c}</span><span>{a}</span></li>)}
        </ul>
      </div>
    </div>
  </div>
  <figcaption>Edit the file. The app follows.</figcaption>
</figure>

<style>
  .demo {
    margin: 0;
  }
  .panes {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    text-align: left;
  }
  .pane {
    min-width: 0;
  }

  /* ── File side ─────────────────────────────── */
  .src {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--hairline);
  }
  .saved {
    margin-left: auto;
    padding: 2px 8px;
    border-radius: 99px;
    background: var(--accent-wash);
    color: var(--accent);
    font-size: 11px;
    opacity: 0;
    transition: opacity 0.25s;
  }
  pre {
    flex: 1;
    margin: 0;
    padding: 16px 18px;
    overflow: hidden;
    color: var(--ink-2);
    font: 12.5px/1.85 var(--mono);
    white-space: pre;
    mask-image: linear-gradient(to right, #000 88%, transparent);
  }
  .k {
    color: var(--muted);
  }
  .id {
    color: var(--muted);
  }
  .new {
    display: inline-block;
    margin: 0 -18px;
    padding: 0 18px;
    border-radius: 4px;
    transition: background 0.4s;
  }
  .assigned {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    vertical-align: bottom;
    color: var(--accent);
    transition: max-width 0.5s ease;
  }
  .typed {
    color: var(--ink);
  }
  .caret {
    display: inline-block;
    width: 7px;
    height: 1.2em;
    margin-left: 1px;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .note {
    position: relative;
    margin: 0;
    padding: 12px 18px;
    border-top: 1px solid var(--hairline);
    color: var(--muted);
    font-size: 13px;
    min-height: 46px;
  }
  .note span {
    transition: opacity 0.35s;
  }
  .n2 {
    position: absolute;
    inset: 12px 18px;
    color: var(--ink-2);
    opacity: 0;
  }
  .n2 :global(svg) {
    display: inline;
    width: 15px;
    height: 15px;
    margin-right: 4px;
    vertical-align: -3px;
    color: var(--up);
  }

  /* ── App side ──────────────────────────────── */
  .app {
    padding: 18px 22px 20px;
    background: var(--content);
    font-size: 13px;
  }
  .app-head {
    display: flex;
    justify-content: space-between;
    font-size: 12.5px;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
  }
  .live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--up);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--up) 60%, transparent);
  }
  .total {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 6px 0 14px;
  }
  .total .b,
  .total .a {
    font-size: 34px;
    font-weight: 650;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .total small {
    color: var(--muted);
  }
  /* before/after values: swap when the row lands */
  .a {
    display: none;
  }
  .cats {
    display: grid;
    gap: 7px;
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
  }
  .cats li {
    display: grid;
    grid-template-columns: 78px 1fr 54px;
    align-items: center;
    gap: 10px;
    margin: 0 -8px;
    padding: 2px 8px;
    border-radius: 6px;
    transition: background 0.5s;
  }
  .name {
    color: var(--ink-2);
  }
  .bar {
    height: 8px;
    overflow: hidden;
    border-radius: 4px;
    background: var(--hairline);
  }
  .bar i {
    display: block;
    width: var(--w);
    height: 100%;
    border-radius: 4px;
    background: var(--c);
    transition: width 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .amt {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .recent {
    padding-top: 12px;
    border-top: 1px solid var(--hairline);
  }
  .rh {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4px;
    font-weight: 600;
  }
  .rh .muted {
    font-weight: 400;
    font-size: 12px;
  }
  .recent ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .recent li {
    display: grid;
    grid-template-columns: 1fr auto 70px;
    gap: 12px;
    padding: 5px 0;
    border-bottom: 1px solid var(--hairline);
    font-variant-numeric: tabular-nums;
  }
  .recent li:last-child {
    border-bottom: 0;
  }
  .recent li span:last-child {
    text-align: right;
  }
  .recent .muted {
    font-size: 12px;
  }
  .added {
    display: grid;
    max-height: 0;
    padding-block: 0 !important;
    overflow: hidden;
    border-bottom-width: 0 !important;
    opacity: 0;
    transition:
      max-height 0.45s ease,
      padding 0.45s ease,
      opacity 0.45s ease 0.1s;
  }
  figcaption {
    margin-top: 18px;
    color: var(--muted);
    font-size: 14px;
    text-align: center;
  }

  /* ── States (set by the script) ────────────── */
  [data-state~='saved'] .saved {
    opacity: 1;
  }
  [data-state~='saved'] .caret {
    display: none;
  }
  [data-state~='synced'] .total .b,
  [data-state~='synced'] .amt .b {
    display: none;
  }
  [data-state~='synced'] .total .a,
  [data-state~='synced'] .amt .a {
    display: inline;
  }
  [data-state~='synced'] .grows {
    background: var(--accent-wash);
  }
  [data-state~='synced'] .grows .bar i {
    width: var(--w2);
  }
  [data-state~='synced'] .added {
    max-height: 40px;
    padding-block: 5px !important;
    border-bottom-width: 1px !important;
    opacity: 1;
  }
  [data-state~='synced'] .live i {
    animation: ping 1s ease-out;
  }
  @keyframes ping {
    to {
      box-shadow: 0 0 0 8px transparent;
    }
  }
  [data-state~='id'] .assigned {
    max-width: 8ch;
  }
  [data-state~='id'] .new {
    background: var(--accent-wash);
  }
  [data-state~='id'] .n1 {
    opacity: 0;
  }
  [data-state~='id'] .n2 {
    opacity: 1;
  }
  [data-state~='id'] .grows {
    background: transparent;
  }
  [data-state~='fade'] .panes {
    opacity: 0.35;
    transition: opacity 0.4s;
  }

  @media (max-width: 860px) {
    .panes {
      grid-template-columns: minmax(0, 1fr);
    }
    .src {
      border-right: 0;
      border-bottom: 1px solid var(--hairline);
    }
    pre {
      font-size: 11px;
    }
  }
</style>

<script>
  const demo = document.querySelector<HTMLElement>('[data-demo]');
  const typedEl = demo?.querySelector<HTMLElement>('.typed');
  if (demo && typedEl) {
    const text = demo.dataset.typed ?? '';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const set = (s: string) => (demo.dataset.state = s);
    let visible = false;
    let running = false;

    const finalState = () => {
      typedEl.textContent = text;
      set('saved synced id');
    };

    async function loop() {
      if (running) return;
      running = true;
      while (visible) {
        set('');
        typedEl.textContent = '';
        await sleep(900);
        for (let i = 1; i <= text.length && visible; i++) {
          typedEl.textContent = text.slice(0, i);
          await sleep(text[i - 1] === ',' ? 70 : 32);
        }
        if (!visible) break;
        await sleep(450);
        set('saved');
        await sleep(650);
        set('saved synced');
        await sleep(1500);
        set('saved synced id');
        await sleep(4200);
        set('saved synced id fade');
        await sleep(450);
      }
      running = false;
      finalState();
    }

    if (reduce || !('IntersectionObserver' in window)) {
      finalState();
    } else {
      new IntersectionObserver(
        ([e]) => {
          visible = e.isIntersecting;
          if (visible) loop();
        },
        { threshold: 0.35 },
      ).observe(demo);
    }
  }
</script>
