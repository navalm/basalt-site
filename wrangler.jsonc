// One Worker serves the static site (./dist, built by Astro) and the waitlist endpoint.
// First deploy: see README.md ("Deploy").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "basalt-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "basalt.navalm.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "basalt-waitlist",
      "database_id": "926b56ef-df98-4ec6-a171-11446f02e5f3"
    }
  ],
  "ratelimits": [
    { "name": "WAITLIST_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
